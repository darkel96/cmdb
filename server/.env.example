# Einstellungen des CMDB-Dienstes. Kopieren nach server/.env (wird nicht eingecheckt) und ausfüllen:
#   cp server/.env.example server/.env && chmod 600 server/.env
# Passwörter und Schlüssel nur hier eintragen, nie ins Repository, in Tickets oder in den Chat.

# --- Betrieb -----------------------------------------------------------------------------------------------
# Testmodus: feste Testbenutzer „admin“ und „user“ (Passwort „test“), kein LDAP, keine Datenbank, erfundene Daten.
# Nur für Entwicklung und Tests. Im Betrieb 0 oder weglassen.
CMDB_TESTMODE=0

# Schlüssel für das signierte Session-Cookie, mindestens 32 Zeichen. Erzeugen z. B. mit:  openssl rand -hex 32
# Ein neuer Schlüssel meldet alle Personen ab.
CMDB_SESSION_SECRET=
# Gültigkeit einer Anmeldung in Stunden
CMDB_SESSION_HOURS=8
# „Angemeldet bleiben“ auf der Anmeldeseite: Sitzung so viele Tage (höchstens 30)
CMDB_REMEMBER_DAYS=7

# HTTPS direkt im Dienst (PEM-Dateien, im Container unter /certs). Ohne HTTPS ist die echte Anmeldung gesperrt,
# ausser hinter einem Reverse-Proxy mit HTTPS (dann CMDB_TRUST_PROXY=1).
CMDB_TLS_CERT=/certs/tls.crt
CMDB_TLS_KEY=/certs/tls.key
CMDB_TRUST_PROXY=0
# Nur für lokale Entwicklung: Anmeldung über unverschlüsseltes HTTP erlauben. Im Betrieb nie setzen.
CMDB_ALLOW_INSECURE_HTTP=0

# --- Anmeldung (Active Directory) ---------------------------------------------------------------------------
# Nur LDAPS (ldaps://…:636) oder LDAP mit StartTLS (ldap://…:389, StartTLS ist dann Pflicht). Kein Klartext-LDAP.
# Kein Service-Account: Der Dienst meldet sich mit Benutzer und Passwort der Person selbst am AD an.
CMDB_LDAP_URL=ldaps://rom.aberle-it.loc:636
CMDB_LDAP_DOMAIN=aberle-it.loc
CMDB_LDAP_NETBIOS=ABERLE-IT
# Nur Konten unterhalb dieser OU dürfen sich anmelden
CMDB_LDAP_BASE_DN=OU=Aberle Automation,OU=Aberle Mitarbeiter,DC=Aberle-IT,DC=loc
# CA-Zertifikat der internen CA (PEM), damit das LDAPS-Zertifikat geprüft werden kann
CMDB_LDAP_CA=/certs/ca.crt
CMDB_LDAP_TIMEOUT_MS=8000

# Rollen: alle angemeldeten Personen sind „user“. Admins per Anmeldename (Komma-getrennt) …
CMDB_ADMINS=dario.keller
# Lokales Admin-Konto ohne AD (z. B. Rechte mit dem eigenen AD-Konto testen). Nur Name und Hash, nie das Passwort;
# setzen mit: docker run --rm -it -v /root/cmdb/server:/s node:24-alpine node /s/tools/lokaler-admin.mjs admin
CMDB_LOCAL_ADMIN_USER=
CMDB_LOCAL_ADMIN_HASH=
# … oder später über eine AD-Gruppe (CN oder vollständiger DN)
CMDB_ADMIN_GROUP=

# Begrenzung fehlgeschlagener Anmeldungen: je Benutzer so viele Fehlversuche (je Adresse das Vierfache) …
CMDB_LOGIN_MAX_FAILURES=5
# … innerhalb dieses Fensters; danach ist die Anmeldung bis zum Ende des Fensters gesperrt
CMDB_LOGIN_LOCK_MINUTES=15

# --- Datenbank (SQL Server) ---------------------------------------------------------------------------------
# Phase 0 prüft nur die Verbindung (Version, Datenbank, Login). Eigener Login, kein sa.
CMDB_DB_SERVER=kingstown.aberle-it.loc
CMDB_DB_PORT=1433
CMDB_DB_NAME=CMDB
CMDB_DB_USER=svc_cmdb
CMDB_DB_PASSWORD=
# Verbindung ist immer verschlüsselt. Zertifikat prüfen über die CA (PEM) …
CMDB_DB_CA=/certs/ca.crt
# … oder, nur wenn der SQL Server kein Zertifikat einer CA hat, dem Zertifikat ohne Prüfung vertrauen
CMDB_DB_TRUST_CERT=0

# --- E-Mail (SMTP) -----------------------------------------------------------------------------------------
# Vorgaben; in der Verwaltung (Status › E-Mail) änderbar. Leer = kein Mailversand.
CMDB_SMTP_HOST=
CMDB_SMTP_PORT=587
# starttls (587), tls (465) oder none (nur internes Relay ohne Anmeldung)
CMDB_SMTP_SECURITY=starttls
CMDB_SMTP_USER=
CMDB_SMTP_PASSWORD=
CMDB_SMTP_FROM=
CMDB_SMTP_FROM_NAME=CMDB
# CA (PEM), falls der Mailserver ein Zertifikat der internen CA hat
CMDB_SMTP_CA=

# --- Daten des Dienstes --------------------------------------------------------------------------------------
# Einstellungen aus der Verwaltung (Volume „daten“ im Container, Passwörter verschlüsselt mit CMDB_SESSION_SECRET)
CMDB_DATA_DIR=/app/data
